{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/routes/**/*.{ts,tsx}",
    "src/server.ts",
    "src/start.ts",
    "src/router.tsx",
    "scripts/**/*.ts",
    "e2e/**/*.ts",
    "src/**/*.test.ts",
    "src/pwa/sw.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.ts",
    "e2e/**/*.ts"
  ],
  "ignore": [
    "src/components/ui/**"
  ]
}
