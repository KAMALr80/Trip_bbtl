# Copy to .env.local for local development. Never commit real secrets.

# --- Browser (bundled into the client; publishable values only) ---
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Optional: browser error reporting. Leave empty to only log to the console.
VITE_SENTRY_DSN=
# Offline service worker (M4-02). Off locally; scripts/deploy.sh turns it on for staging and
# production. Deploying with VITE_SERVICE_WORKER=false ships the kill switch (a self-removing sw.js).
VITE_SERVICE_WORKER=

# --- Server (Cloudflare Worker secrets: `wrangler secret put NAME --env staging|production`) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Bearer secret for pg_cron → /api/public/* calls. *_PREVIOUS keeps the old one valid while rotating.
# (The photo purge job authenticates with trip_private.cron_keys instead; see
# supabase/migrations/20261021120000_cron_purge_photos_endpoint.sql.)
CRON_SECRET=
CRON_SECRET_PREVIOUS=
# AI provider (M0-08). AI features stay off until AI_API_KEY and AI_MODEL are both set.
AI_API_KEY=
AI_MODEL=
# Optional: an OpenAI-compatible endpoint instead of OpenAI.
AI_BASE_URL=
# Optional: the model's USD price per 1M input / output tokens, for the founder's AI cost report.
AI_PRICE_IN=
AI_PRICE_OUT=
